 }
+/* ===================================================================
+   LOG SPLITTER: drag the bar under the Cube log to move height between the Cube log and the Jetson log.
+   Each log stays at least LOG_MIN_PX tall. The split is remembered; double-click the bar to go back to equal.
+   =================================================================== */
+(function () {
+  const LOG_MIN_PX = 60, KEY_STEP_PX = 20, SPLIT_KEY = "rov.logSplit";
+  const bar = $("logSplit"), a = $("log"), b = $("jlog");
+  const setShare = (share) => {                        // share = fraction of the shared height given to the Cube log
+    a.style.flexGrow = share; b.style.flexGrow = 1 - share;
+    bar.setAttribute("aria-valuenow", Math.round(share * 100));
+  };
+  const moveTo = (aPx) => {                            // give the Cube log aPx pixels, the Jetson log the rest, within limits
+    const total = a.offsetHeight + b.offsetHeight;
+    if (total < 2 * LOG_MIN_PX) return;
+    const clamped = Math.min(total - LOG_MIN_PX, Math.max(LOG_MIN_PX, aPx));
+    setShare(clamped / total);
+    try { localStorage.setItem(SPLIT_KEY, String(clamped / total)); } catch (e) {}
+  };
+  let saved = 0.5;
+  try { const v = parseFloat(localStorage.getItem(SPLIT_KEY)); if (v > 0 && v < 1) saved = v; } catch (e) {}
+  setShare(saved);
+
+  let startY = 0, startA = 0;
+  bar.addEventListener("pointerdown", (e) => { startY = e.clientY; startA = a.offsetHeight; bar.setPointerCapture(e.pointerId); bar.classList.add("dragging"); e.preventDefault(); });
+  bar.addEventListener("pointermove", (e) => { if (bar.classList.contains("dragging")) moveTo(startA + e.clientY - startY); });
+  bar.addEventListener("mousedown", (e) => e.preventDefault());     // stops a drag or double-click from selecting text in the panel
+  ["pointerup", "pointercancel"].forEach((t) => bar.addEventListener(t, () => bar.classList.remove("dragging")));
+  bar.addEventListener("dblclick", () => { setShare(0.5); try { localStorage.removeItem(SPLIT_KEY); } catch (e) {} });
+  bar.addEventListener("keydown", (e) => {
+    if (e.key === "ArrowUp" || e.key === "ArrowDown") { e.preventDefault(); moveTo(a.offsetHeight + (e.key === "ArrowDown" ? KEY_STEP_PX : -KEY_STEP_PX)); }
+  });
+})();
+
 $("joyBtn").onclick = () => backend.set_joystick_enabled(backend.get_data().joystick_enabled === false);
 setInterval(drawSent, 100);
 drawSent();
