-.nav { display: flex; gap: 18px; flex-wrap: wrap; font-size: 12px; align-items: center; justify-content: flex-start; padding-left: 20px;}
-.modebtn { margin-left:auto; font-size: 11px; background: var(--inset-bg); border: var(--border-w) solid var(--line); border-radius: var(--radius-sm); padding: 3px 8px; cursor: pointer; }
-.modebtn:hover { border-color: var(--text); }
+  padding: 3px var(--gap); background: var(--top-bar-bg); border-bottom: var(--border-w) solid var(--line); height: 30px;}
+.brand { font: 400 22px BBH; color: var(--title);}
+.mid_head{display: flex; max-height: 30px; justify-content: center; align-items: center;gap: 10px;}
+.mid_head img {max-height: 25px;}
+.nav { display: flex; gap: 18px; flex-wrap: wrap; font-size: 14px; align-items: center; justify-content: flex-start; padding-left: 20px;}
+/* light-mode switch (iOS style): the track is the button, the knob is ::after. aria-checked="true" = light mode on */
+.modebtn { justify-self: end; position: relative; width: 40px; height: 22px; padding: 0; border: none; border-radius: 999px;
+  background: var(--switch-off); font-size: 0; cursor: pointer; transition: background .25s ease; }
+.modebtn::after { content: "☾"; position: absolute; top: 2px; left: 2px; width: 18px; height: 18px; border-radius: 50%;
+  background: #fff; color: #555; font: 11px/18px system-ui, sans-serif; text-align: center;
+  box-shadow: 0 1px 3px rgba(0, 0, 0, .35); transition: transform .25s cubic-bezier(.3, 1.4, .5, 1); }
+.modebtn[aria-checked="true"] { background: var(--switch-on); }
+.modebtn[aria-checked="true"]::after { content: "☀"; color: #c98a00; transform: translateX(18px); }
+.modebtn:hover { filter: brightness(1.12); }
 .nav a, .nav span { color: var(--dim); text-decoration: none; padding: 1px 0; border-bottom: 1px solid transparent; }
 .nav a:hover { color: var(--text); border-bottom-color: var(--dim); }
 .nav [aria-current="page"] { color: var(--text); border-bottom-color: var(--text); }
-.brand { font-size: 18px;}
 
 /* a plain sub-page: one gray box under the top bar that scrolls by itself */
 .page { background: var(--panel-bg); border-radius: var(--radius); padding: 14px; overflow: auto; min-height: 0; }
@@ -120,17 +141,20 @@ button, select { font: inherit; color: inherit; letter-spacing: inherit; }
 .jstate .name { color: var(--dim); }
 
 /* log boxes (newest line on top: red = problems, amber = warnings) */
-.log { background: var(--inset-bg); border: var(--border-w) solid var(--line); border-radius: var(--radius); overflow-y: auto; padding: 6px 8px; font-size: 12px; line-height: 1.5; }
+.log { background: var(--inset-bg); border: var(--border-w) solid var(--line); border-radius: var(--radius); overflow-y: auto; padding: 6px 8px; font-size: 12px; line-height: 1.5; font-family: var(--font); }
 .log .none { color: var(--dim); }
 .log .row { display: flex; gap: 8px; }
 .log .t { color: var(--dim); flex: none; }
 .log .warn { color: var(--amber); }
 .log .err { color: var(--alert); }
 
+.v {
